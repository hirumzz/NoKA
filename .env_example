# NoKA Environment Configuration
# Copy this file to .env and fill in your values.

# -------------------------------------------------------
# Server
# -------------------------------------------------------
PORT=1337

# -------------------------------------------------------
# Database Configuration (PostgreSQL)
# -------------------------------------------------------
# Option A: Use individual fields
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_DATABASE=konga

# Option B: Use connection URI directly (Overrides Option A if set)
# DB_URI=postgresql://postgres:your_password@localhost:5432/konga

# -------------------------------------------------------
# Security — REQUIRED IN PRODUCTION
# -------------------------------------------------------
# JWT signing secret. Must be a strong random string (32+ chars).
# If not set, a random secret is generated per-restart (sessions lost on restart).
TOKEN_SECRET=change-me-to-a-strong-random-secret

# Exact browser origin allowed for CORS (no trailing slash).
# If not set, defaults to http://localhost:13337.
ALLOWED_ORIGIN=http://localhost:13337
