# NoKA Environment Configuration
# Copy this file to .env and fill in your values.

# -------------------------------------------------------
# Server
# -------------------------------------------------------
PORT=1337

# -------------------------------------------------------
# Database Configuration (PostgreSQL)
# -------------------------------------------------------
# Option A: Use individual fields
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_DATABASE=konga

# Option B: Use connection URI directly (Overrides Option A if set)
# DB_URI=postgresql://postgres:your_password@localhost:5432/konga

# -------------------------------------------------------
# Security — REQUIRED IN PRODUCTION
# -------------------------------------------------------
# JWT signing secret. Must be a strong random string (32+ chars).
# If not set, a random secret is generated per-restart (sessions lost on restart).
TOKEN_SECRET=change-me-to-a-strong-random-secret

# Encryption key used for securing sensitive node credentials in DB (e.g., Kong JWT token).
# Must be exactly 16, 24, or 32 bytes string.
ENCRYPTION_KEY=change-me-to-a-32-byte-secret-key

# Exact browser origin allowed for CORS (no trailing slash).
# If not set, defaults to http://localhost:13337.
ALLOWED_ORIGIN=http://localhost:13337

# Enable initial setup signup screen for the first Admin
SIGNUP_ENABLED=true

# Set to true to allow Konga to connect to internal IP addresses (e.g. localhost, 127.0.0.1) for node reachability.
# WARNING: Only enable this if Konga and Kong are intentionally on the same internal network.
ALLOW_INTERNAL_SSRF=false
